# ============================================================
# PigHome 项目 .gitignore
# 排除隐私文件和构建产物
# ============================================================

# ---- 隐私文件 ----
.env
*.env.local
*.env.production

# ---- Node.js ----
node_modules/
npm-debug.log*

# ---- HarmonyOS 构建产物 ----
.hvigor/
oh_modules/
**/build/
local.properties

# ---- IDE ----
.idea/
.vscode/
*.swp
*.swo

# ---- 系统文件 ----
.DS_Store
Thumbs.db
desktop.ini

# ---- 日志 ----
*.log
